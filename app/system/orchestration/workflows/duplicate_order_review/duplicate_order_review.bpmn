<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_DuplicateOrderReview"
  targetNamespace="https://labtycoon.local/workflows">
  <bpmn:process id="duplicate_order_review" name="Duplicate Order Review" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start_to_evaluate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="evaluate_duplicate_hint" name="Possible duplicate?">
      <bpmn:incoming>flow_start_to_evaluate</bpmn:incoming>
      <bpmn:outgoing>flow_duplicate_to_review_flag</bpmn:outgoing>
      <bpmn:outgoing>flow_not_duplicate_to_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="create_review_flag" name="Create passive review flag">
      <bpmn:incoming>flow_duplicate_to_review_flag</bpmn:incoming>
      <bpmn:outgoing>flow_review_flag_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>flow_review_flag_to_end</bpmn:incoming>
      <bpmn:incoming>flow_not_duplicate_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_to_evaluate" sourceRef="start" targetRef="evaluate_duplicate_hint" />
    <bpmn:sequenceFlow id="flow_duplicate_to_review_flag" sourceRef="evaluate_duplicate_hint" targetRef="create_review_flag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">possible_duplicate_order_matched == True</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_not_duplicate_to_end" sourceRef="evaluate_duplicate_hint" targetRef="end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">possible_duplicate_order_matched != True</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_review_flag_to_end" sourceRef="create_review_flag" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_DuplicateOrderReview">
    <bpmndi:BPMNPlane id="BPMNPlane_DuplicateOrderReview" bpmnElement="duplicate_order_review">
      <bpmndi:BPMNShape id="Shape_start" bpmnElement="start">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gateway" bpmnElement="evaluate_duplicate_hint" isMarkerVisible="true">
        <dc:Bounds x="220" y="113" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task" bpmnElement="create_review_flag">
        <dc:Bounds x="340" y="98" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end" bpmnElement="end">
        <dc:Bounds x="560" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_flow_start_to_evaluate" bpmnElement="flow_start_to_evaluate">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="220" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_duplicate_to_review_flag" bpmnElement="flow_duplicate_to_review_flag">
        <di:waypoint x="270" y="138" />
        <di:waypoint x="340" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_review_flag_to_end" bpmnElement="flow_review_flag_to_end">
        <di:waypoint x="480" y="138" />
        <di:waypoint x="560" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_not_duplicate_to_end" bpmnElement="flow_not_duplicate_to_end">
        <di:waypoint x="245" y="163" />
        <di:waypoint x="245" y="230" />
        <di:waypoint x="578" y="230" />
        <di:waypoint x="578" y="156" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
